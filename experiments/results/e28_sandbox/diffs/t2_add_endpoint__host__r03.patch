+def project_stats(store, project_id: int) -> dict:
+    get_project_or_404(store, project_id)
+    tasks = [task for task in get_repo(store, "tasks").all() if task.project_id == project_id]
+    by_status = {status: sum(task.status == status for task in tasks) for status in TASK_STATUSES}
+    return {"project_id": project_id, "total": len(tasks), "by_status": by_status}
