+def project_stats(store, project_id: int) -> dict:
+    get_project_or_404(store, project_id)
+    counts = {status: 0 for status in TASK_STATUSES}
+    for task in get_repo(store, "tasks").all():
+        if task.project_id == project_id:
+            counts[task.status] += 1
+    return {"project_id": project_id, "total": sum(counts.values()), "by_status": counts}
+
