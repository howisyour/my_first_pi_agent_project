+def get_project_stats(store, project_id: int) -> dict:
+    get_project_or_404(store, project_id)
+    by_status = {status: 0 for status in TASK_STATUSES}
+    for task in get_repo(store, "tasks").all():
+        if task.project_id == project_id and task.status in by_status:
+            by_status[task.status] += 1
+    return {"project_id": project_id, "total": sum(by_status.values()), "by_status": by_status}
+
+
