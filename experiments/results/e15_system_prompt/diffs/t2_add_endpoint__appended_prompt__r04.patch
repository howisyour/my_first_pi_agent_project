@@ -1,5 +1,6 @@
 """Project use cases."""
 
+from taskapp.constants import TASK_STATUSES
 from taskapp.errors import NotFoundError
 from taskapp.models_generated import Project
 from taskapp.services.users import get_user_or_404
@@ -28,3 +29,13 @@ def archive_project(store, project_id: int) -> Project:
     project = get_project_or_404(store, project_id)
     project.archived = True
     return get_repo(store, "projects").save(project)
+
+
+def get_project_stats(store, project_id: int) -> dict:
+    get_project_or_404(store, project_id)
+    counts = {status: 0 for status in TASK_STATUSES}
+    tasks = [task for task in get_repo(store, "tasks").all() if task.project_id == project_id]
+    for task in tasks:
+        if task.status in counts:
+            counts[task.status] += 1
+    return {"project_id": project_id, "total": len(tasks), "by_status": counts}
